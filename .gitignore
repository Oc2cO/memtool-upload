# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
ios/
android/

# Local Expo modules ship Swift/Kotlin sources alongside their JS
# surface — they live inside `modules/*/ios/` and `modules/*/android/`
# and must be tracked even though the broader `ios/` / `android/`
# rules above hide the prebuild output.
!modules/*/ios/
!modules/*/ios/**
!modules/*/android/
!modules/*/android/**
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Google Play service account (used by `eas submit --platform android`)
google-play-service-account.json
google-play-service-account*.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

.env
