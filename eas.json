{
  "cli": {
    "version": ">= 14.7.1",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_REPLIT_API_BASE_URL": "https://oc2coos-2.polsia.app/api/memtool",
        "EXPO_PUBLIC_AUTH_API_BASE_URL": "https://oc2coos-2.polsia.app/api/memtool",
        "EXPO_PUBLIC_SENTRY_DSN": "$EXPO_PUBLIC_SENTRY_DSN"
      },
      "ios": {
        "image": "latest"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_LIVE_ACTIVITIES_REQUIRED": "1",
        "EXPO_PUBLIC_REPLIT_API_BASE_URL": "https://oc2coos-2.polsia.app/api/memtool",
        "EXPO_PUBLIC_AUTH_API_BASE_URL": "https://oc2coos-2.polsia.app/api/memtool",
        "EXPO_PUBLIC_SENTRY_DSN": "$EXPO_PUBLIC_SENTRY_DSN"
      },
      "ios": {
        "credentialsSource": "remote",
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "Smakis3303@gmail.com",
        "appleTeamId": "7JDY7C3VR5",
        "ascAppId": "6765775373"
      },
      "android": {
        "serviceAccountKeyPath": "$GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_PATH",
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": false
      }
    }
  }
}
