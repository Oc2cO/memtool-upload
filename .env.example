# MemTool environment variables
# Copy this file to `.env` and fill in real values for local development.
# Never commit `.env` — only this `.env.example` template should be tracked.
#
# NOTE: MemTool ships iOS-only via App Store Connect. There is no Android /
# Play Store build target — see eas.json (no `android` block) and app.json
# (no `expo.android` block). Do not re-add Android-only env vars here.

# RevenueCat iOS public SDK key.
# Get this from: RevenueCat dashboard → Project Settings → API keys → Apple App Store (public app-specific key, starts with "appl_").
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxx

# RevenueCat test/sandbox public SDK key used in dev/Expo Go builds.
# Get this from: RevenueCat dashboard → Project Settings → API keys (use a sandbox / test app key, or reuse the platform key for local testing).
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret used to authenticate metrics ingestion requests between the app and the API server.
# Generate a long random string (e.g. `openssl rand -hex 32`) and configure the same value on the server side.
METRICS_SHARED_SECRET=replace-with-a-long-random-string

# Base URL of the Replit-hosted API server used by the app.
# In development this is typically the proxy domain from $REPLIT_DEV_DOMAIN with the `/api` prefix; in production use the deployed domain (e.g. https://your-app.replit.app/api).
EXPO_PUBLIC_REPLIT_API_BASE_URL=https://your-dev-domain.replit.dev/api

# Base URL of the auth API used by the app.
# Usually the same host as the Replit API server with the auth path (e.g. https://your-app.replit.app/api/auth). Override per environment as needed.
EXPO_PUBLIC_AUTH_API_BASE_URL=https://your-dev-domain.replit.dev/api/auth

# Sentry DSN for the `memtool-mobile` project (errors-only crash reporting).
# Get this from: Sentry → memtool-mobile project → Settings → Client Keys (DSN).
# MUST be present at EAS build time — Expo bakes EXPO_PUBLIC_* values into the
# JS bundle. If unset, lib/sentry.ts logs one warning and the SDK no-ops.
# For TestFlight / App Store builds, set this as an EAS shared env var so
# eas.json's `$EXPO_PUBLIC_SENTRY_DSN` reference resolves on the build server.
EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
