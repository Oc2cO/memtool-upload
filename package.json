    "serve": "node server/serve.js",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit && node scripts/verify-store-screenshots.js",
    "audit:prelaunch": "tsx scripts/audit-prelaunch.ts",
