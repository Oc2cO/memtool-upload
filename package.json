    "verify:store-screenshots": "node scripts/verify-store-screenshots.js",
    "eas-build-post-install": "node scripts/verify-live-activities-config.js",
    "lint": "eslint . --ext .ts,.tsx",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
