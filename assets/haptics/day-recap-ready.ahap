{
  "Version": 1.0,
  "Metadata": {
    "Project": "MemTool",
    "Pattern": "day-recap-ready",
    "Created": "2026-05-01",
    "Description": "A gentle three-tap chime over a short shimmer. The 'your day is summarised' arrival cue."
  },
  "Pattern": [
    {
      "Event": {
        "Time": 0.0,
        "EventType": "HapticContinuous",
